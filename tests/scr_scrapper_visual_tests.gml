function scrapper_visual_assert(_ok,_label) {
    if(!_ok) throw "SCRAPPER_VISUAL_FAILURE: "+_label;
    global.scrapper_visual_passes++;
}
function scrapper_visual_tests() {
    global.scrapper_visual_passes=0;global.recycler_passes=0;
    var g=instance_find(obj_game,0),r=g.recycler_robot,board=r.board_device;
    var machines=robots_table_machines(g);
    scrapper_visual_assert(array_length(machines)==1&&machines[0]==r,"free starting recycler is visible on the table");
    var idle=robot_idle_sprite(r),work=robot_work_sprite(r);
    scrapper_visual_assert(sprite_exists(idle)&&sprite_exists(work)&&sprite_get_number(work)>1,"scrapper has idle and animated work sprites");
    scrapper_visual_assert(robot_table_sprite(r)==idle&&r.work_frame==0&&!r.working,"empty starting scrapper idles");
    var rect=robot_table_hit_rect(r,0),donor=campaign_item_rect(5),plate=campaign_plate_rect();
    scrapper_visual_assert(rect[1]>=donor[3]&&rect[2]<plate[0]&&rect[3]<=656,"scrapper clears donors, plate and generator controls");
    assembler_visual_capture(g,"scrapper-idle");
    scrapper_visual_assert(campaign_table_click(g,rect[0]+20,rect[1]+20)&&g.active_device==board&&global.mode==GameMode.Play,"unpowered table click opens persistent queue");
    var a=instance_create_depth(0,0,-10,obj_module_battery),b=instance_create_depth(0,0,-10,obj_module_coil);
    scrapper_visual_assert(inventory_add(g,a)&&inventory_add(g,b),"real fixture parts stored");
    recycler_test_feed(g,r,a,0,0);recycler_test_feed(g,r,b,2,0);
    robots_tick(g,1);
    scrapper_visual_assert(!r.working&&robot_table_sprite(r)==idle&&g.scrap==0,"unpowered queue does not consume parts or animate");
    campaign_table(g);scrapper_visual_assert(robot_assign_power(g,r)&&g.power_used==2,"scrapper still requires two energy");
    robots_tick(g,0);
    scrapper_visual_assert(r.working&&r.target_module==a&&robot_table_sprite(r)==work&&r.work_frame==0,"automatic queue start switches to work from frame zero");
    var frame_rate=sprite_get_speed(work);
    if(sprite_get_speed_type(work)==spritespeed_framespergameframe) frame_rate*=game_get_speed(gamespeed_fps);
    var frame_time=1/frame_rate;
    robots_tick(g,frame_time*1.25);
    scrapper_visual_assert(floor(r.work_frame)==1,"authored animation speed advances frames");
    assembler_visual_capture(g,"scrapper-working-frame1");
    robots_tick(g,frame_time*2);
    scrapper_visual_assert(floor(r.work_frame)==3,"work advances to another frame");
    assembler_visual_capture(g,"scrapper-working-frame3");
    var before=r.work_frame;
    robots_tick(g,sprite_get_number(work)/frame_rate);
    scrapper_visual_assert(abs(r.work_frame-before)<0.001,"work animation loops");
    var time_left=r.remaining;
    global.mode=GameMode.Pause;robots_tick(g,3);
    scrapper_visual_assert(r.remaining==time_left&&r.work_frame==before,"pause freezes progress and frame");global.mode=GameMode.Menu;
    generator_stop(g,"scrapper test");robots_tick(g,3);
    scrapper_visual_assert(robot_table_sprite(r)==idle&&r.work_frame==0&&r.remaining==time_left&&instance_exists(a),"outage shows idle without losing reserved module");
    generator_restart(g);robots_tick(g,frame_time*1.25);
    scrapper_visual_assert(robot_table_sprite(r)==work&&floor(r.work_frame)==1,"power restoration resumes work animation");
    scrapper_visual_assert(campaign_table_click(g,rect[0]+20,rect[1]+20)&&g.active_device==board&&r.target_module==a,"working table click opens queue without restarting job");
    campaign_table(g);robots_tick(g,r.remaining);
    scrapper_visual_assert(!r.working&&robot_table_sprite(r)==idle&&r.work_frame==0&&!instance_exists(a)&&g.scrap==1,"completion returns to idle and pays half module price once");
    robots_tick(g,0);
    scrapper_visual_assert(r.working&&r.target_module==b&&r.work_frame==0,"next queued module starts automatically with fresh animation");
    robots_tick(g,30);robots_tick(g,1);
    scrapper_visual_assert(!r.working&&robot_table_sprite(r)==idle&&g.scrap==2&&!instance_exists(b),"empty queue stays idle after final completion");
    g.money=500;shop_buy(g,"assembler_robot");shop_buy(g,"solder_robot");shop_buy(g,"dismantle_robot");
    machines=robots_table_machines(g);
    scrapper_visual_assert(array_length(machines)==4&&g.robot_stack_front[0]==0,"all four robot types remain visible together");
    shop_buy(g,"assembler_robot");var arrow=robot_stack_arrow(1,false);robots_table_click(g,arrow[0]+4,arrow[1]+4);
    scrapper_visual_assert(g.robot_stack_front[0]==0&&g.robot_stack_front[1]==0,"other stack selection leaves scrapper in place");
    scrapper_visual_assert(campaign_table_click(g,rect[0]+20,rect[1]+20)&&g.active_device==board,"scrapper remains clickable after other purchases");campaign_table(g);
    assembler_visual_capture(g,"scrapper-with-robots");
    show_debug_message("SCRAPPER_VISUAL_RESULT passes="+string(global.scrapper_visual_passes)+" failures=0");game_end();
}
