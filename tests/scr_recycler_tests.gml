// Isolated suite; starts after obj_game initialization in Room1.
function recycler_assert(_ok,_label) {
    if(!_ok) throw "RECYCLER_FAILURE: "+_label;
    global.recycler_passes++;
}
function recycler_test_feed(_g,_robot,_item,_col,_row) {
    var d=_robot.board_device;campaign_open(_g,d);
    var slot=-1;
    for(var i=0;i<array_length(_g.inventory);++i) if(_g.inventory[i]==_item) {slot=i;break;}
    recycler_assert(slot>=0,"feed part is in inventory");
    _g.inventory_page=_item.storage_page;
    var px=_g.inventory_x+_item.storage_col*_g.inventory_size+4;
    var py=_g.inventory_y+_item.storage_row*_g.inventory_size+4;
    recycler_assert(inventory_pick(_g,slot,px,py),"pick real inventory part");
    board_drag_update(d,d.board_x+_col*d.cell_size+4,d.board_y+_row*d.cell_size+4);
    recycler_assert(board_drop(d)&&_item.device==d&&!_item.in_inventory,"drop part onto recycler queue");
    recycler_assert(_g.inventory[slot]!=_item,"queue transfer removes inventory entry");
}
function recycler_tests() {
    global.recycler_passes=0;
    var g=instance_find(obj_game,0),r=g.recycler_robot,d=r.board_device;
    recycler_assert(array_length(g.robots)==1&&r.product_id=="recycle_robot"&&g.scrap==0&&g.money==50,"one free starting recycler, separate zero scrap balance");
    recycler_assert(r.energy_cost==2&&r.work_seconds==30&&r.reward==1&&!r.power_allocated,"recycler base configuration");
    recycler_assert(d.is_recycler&&d.rows==3&&d.cols==6&&d.cover_open,"open three-by-six queue");
    recycler_assert(array_length(d.board_ports)==0&&array_length(d.wires)==0,"queue has no contacts or wires");
    recycler_assert(robot_groups(g)[0].machines[0]==r,"recycler row is nearest generator");
    var catalog=shop_catalog();
    recycler_assert(catalog[2].price==100&&catalog[3].price==100&&catalog[2].energy==1&&catalog[3].energy==1,"existing robot prices retained, energy reduced to one");
    g.money=99;recycler_assert(!shop_buy(g,"solder_robot")&&g.money==99,"robot still requires 100 coins");
    g.money=200;recycler_assert(shop_buy(g,"solder_robot")&&shop_buy(g,"dismantle_robot")&&g.money==0,"normal robot purchases unchanged");
    var solder=g.robots[1],dismantler=g.robots[2];
    recycler_assert(robot_assign_power(g,solder)&&robot_assign_power(g,dismantler)&&g.power_used==2,"two one-energy robots share base generator");
    recycler_assert(!robot_assign_power(g,r)&&!r.powered,"recycler requires two free energy");
    robot_release_power(g,solder);robot_release_power(g,dismantler);
    recycler_assert(robot_assign_power(g,r)&&r.powered&&g.power_used==2,"recycler reserves two energy");
    robots_tick(g,0);
    recycler_assert(!r.working&&r.target_module==noone,"powered empty queue waits for input");
    var a=instance_create_depth(0,0,-10,obj_module_battery),b=instance_create_depth(0,0,-10,obj_module_coil);
    var spare=instance_create_depth(0,0,-10,obj_module_universal);
    recycler_assert(inventory_add(g,a)&&inventory_add(g,b)&&inventory_add(g,spare),"fixture parts stored");
    recycler_test_feed(g,r,b,4,1);recycler_test_feed(g,r,a,0,0);
    recycler_assert(!campaign_finish(g)&&!campaign_sell(g)&&instance_exists(d),"queue cannot be scrapped or sold");
    recycler_assert(!wire_input(d,a.x,a.y,true,false)&&array_length(d.wires)==0,"queue input does not start wires");
    recycler_assert(recycler_first_module(r)==a,"first occupied board cell determines input, not child creation order");
    recycler_assert(board_pick(a,a.x+4,a.y+4)&&recycler_first_module(r)==b,"held part cannot be consumed");
    recycler_assert(board_cancel(d)&&recycler_first_module(r)==a,"cancel restores queue order");
    robots_tick(g,0);
    recycler_assert(r.working&&r.target_module==a&&r.remaining==30,"powered recycler automatically reserves first part without a start click");
    recycler_assert(instance_exists(a)&&a.device==noone&&!a.visible&&d.board[0][0]==noone,"processing part detached from queue and retained for preview");
    recycler_assert(instance_exists(spare)&&spare.in_inventory,"general inventory never consumed");
    recycler_assert(!robot_start(g,r)&&r.target_module==a,"busy recycler cannot reserve another part");
    robots_tick(g,15);recycler_assert(r.remaining==15&&g.scrap==0&&instance_exists(a),"no early scrap payout");
    var sf=surface_create(1280,720);surface_set_target(sf);draw_clear(c_black);
    draw_sprite_stretched(spr_table,0,0,0,1280,720);
    with(d) event_perform(ev_draw,0);
    with(par_module) if(device==d) event_perform(ev_draw,0);
    with(g) event_perform(ev_draw,0);
    campaign_gui_draw(g);surface_reset_target();surface_save(sf,"recycler-board-preview.png");surface_free(sf);
    campaign_table(g);
    sf=surface_create(1280,720);surface_set_target(sf);draw_clear(c_black);
    draw_sprite_stretched(spr_table,0,0,0,1280,720);campaign_table_draw(g);campaign_gui_draw(g);generator_draw(g);robots_draw(g);
    surface_reset_target();surface_save(sf,"recycler-table-preview.png");surface_free(sf);
    generator_stop(g,"test");robots_tick(g,100);
    recycler_assert(r.remaining==15&&g.scrap==0&&r.target_module==a,"outage preserves progress and reserved part");
    recycler_assert(generator_restart(g)&&r.powered,"power returns to recycler allocation");
    global.mode=GameMode.Pause;robots_tick(g,100);
    recycler_assert(r.remaining==15&&g.scrap==0,"pause freezes recycling");global.mode=GameMode.Menu;
    robots_tick(g,14);recycler_assert(r.remaining==1&&g.scrap==0,"full thirty seconds required");
    robots_tick(g,1);recycler_assert(g.scrap==1&&!instance_exists(a)&&!r.working&&r.target_module==noone,"one module becomes one scrap");
    robot_finish(g,r);recycler_assert(g.scrap==1,"completion cannot pay twice");
    robots_tick(g,0);recycler_assert(r.working&&r.target_module==b&&r.remaining==30,"queue automatically advances after completion");
    robots_tick(g,30);recycler_assert(g.scrap==2&&!instance_exists(b),"second queue part pays once");
    robots_tick(g,100);recycler_assert(g.scrap==2&&!r.working&&instance_exists(spare),"empty queue never consumes inventory or creates scrap");
    recycler_test_feed(g,r,spare,2,0);robots_tick(g,0);
    recycler_assert(r.working&&r.target_module==spare,"refilled powered queue restarts");campaign_table(g);
    var card=robot_card_rect(0,0);
    recycler_assert(robots_click(g,card[0]+52,card[1]+12,mb_right)&&!r.powered&&g.power_used==0,"right click releases recycler energy");
    robots_tick(g,100);recycler_assert(r.remaining==30&&instance_exists(spare),"released energy freezes processing");
    var modify=robot_job_rect(0,0);
    recycler_assert(robots_click(g,modify[0]+4,modify[1]+4)&&g.active_device==d,"modify button opens queue without power while processing");
    recycler_assert(r.target_module==spare&&d.cover_open,"reopening preserves reserved part");campaign_table(g);
    recycler_assert(robot_assign_power(g,solder)&&robot_assign_power(g,dismantler),"released energy can be assigned to one-energy robots");
    campaign_earn(g);recycler_assert(robot_start(g,solder),"solder robot takes a table plate");var money=g.money;
    robots_tick(g,10);recycler_assert(g.money==money+20&&g.scrap==2,"normal plate income remains coins, not scrap");
    var temp=robot_create_recycler(g),temp_board=temp.board_device;
    var queued=instance_create_depth(0,0,-10,obj_module_battery);queued.device=temp_board;array_push(temp_board.children,queued);board_place(queued,0,0);
    var reserved=instance_create_depth(0,0,-10,obj_module_coil);temp.target_module=reserved;
    instance_destroy(temp);
    recycler_assert(!instance_exists(temp_board)&&!instance_exists(queued)&&!instance_exists(reserved),"robot cleanup owns queue and reserved part");
    g.money=199;
    recycler_assert(shop_buy(g,"recycle_robot")&&g.money==99&&shop_count(g,"recycle_robot")==2,"buy an additional recycler for 100 coins");
    var bought=g.robots[array_length(g.robots)-1];
    recycler_assert(bought.energy_cost==2&&bought.work_seconds==30&&!bought.power_allocated,"purchased recycler uses the starting robot's settings without automatic power");
    recycler_assert(!shop_buy(g,"recycle_robot")&&g.money==99&&shop_count(g,"recycle_robot")==2,"insufficient coins cannot create a recycler");
    var shop=g.shop;g.money=200;shop.open=true;
    var items=shop_items(shop),position=-1;
    for(var i=0;i<array_length(items);++i) if(items[i].id=="recycle_robot") position=i;
    recycler_assert(position>=0,"owned recycler remains available in the shop");
    shop.scroll=max(0,position-shop.page_size+1);var buy=shop_row_button(position,shop.scroll);
    recycler_assert(shop_click(shop,buy[0]+4,buy[1]+4)&&g.money==100&&shop_count(g,"recycle_robot")==3,"scrolled shop button supports repeated recycler purchases");
    var another=g.robots[array_length(g.robots)-1];
    recycler_assert(g.recycler_robot==r&&g.robot_stack_front[0]==2,"new purchases enter the recycler stack without replacing the free starting robot");
    recycler_assert(bought.board_device!=d&&another.board_device!=d&&another.board_device!=bought.board_device,"each recycler owns a separate queue board");
    recycler_assert(bought.board_device.rows==3&&bought.board_device.cols==6&&array_length(bought.board_device.board_ports)==0&&bought.board_device.robot_owner==bought,"purchased queue is a portless three-by-six board owned by its robot");
    sf=surface_create(1280,720);surface_set_target(sf);draw_clear(c_black);
    campaign_table_draw(g);campaign_gui_draw(g);generator_draw(g);robots_draw(g);shop_draw(shop);
    surface_reset_target();surface_save(sf,"recycler-shop-preview.png");surface_free(sf);shop.open=false;
    var part_a=instance_create_depth(0,0,-10,obj_module_battery),part_b=instance_create_depth(0,0,-10,obj_module_coil);
    recycler_assert(inventory_add(g,part_a)&&inventory_add(g,part_b),"store parts for separate purchased queues");
    recycler_test_feed(g,bought,part_a,0,0);recycler_test_feed(g,another,part_b,0,0);campaign_table(g);
    var row=robot_row_layout(robot_groups(g)[0],0);
    recycler_assert(array_length(row.energy)==3&&row.energy[1].robot==bought&&row.energy[2].robot==another,"purchased recyclers contribute their own energy blocks");
    g.generator.stats_base.energy=10;device_stats_update(g.generator);power_update(g);
    recycler_assert(robot_assign_power(g,bought)&&robot_assign_power(g,another),"purchased recyclers reserve energy independently");
    robots_tick(g,0);
    recycler_assert(bought.target_module==part_a&&another.target_module==part_b&&r.target_module==spare,"automatic processing uses each robot's own queue");
    var scrap_before=g.scrap;robots_tick(g,30);
    recycler_assert(g.scrap==scrap_before+2&&!instance_exists(part_a)&&!instance_exists(part_b)&&instance_exists(spare),"parallel recyclers pay once each and leave the unpowered starting job untouched");
    modify=robot_job_rect(0,0);
    recycler_assert(robots_click(g,modify[0]+4,modify[1]+4)&&g.active_device==another.board_device,"stacked modify action opens the purchased front recycler");campaign_table(g);
    show_debug_message("RECYCLER_RESULT passes="+string(global.recycler_passes)+" failures=0");game_end();
}
